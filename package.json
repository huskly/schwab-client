{
  "name": "@huskly/schwab-client",
  "version": "1.4.0",
  "description": "Schwab Market Data and Trading API client",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "repository": "https://github.com/huskly/schwab-client",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=21.0.0"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "format:write": "prettier --write 'src/**/*.ts' 'package.json' 'tsconfig.json'",
    "format:check": "prettier --check 'src/**/*.ts' 'package.json' 'tsconfig.json'",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "check": "yarn lint && yarn format:check && yarn typecheck",
    "test": "npm run build && node --test test/*.test.js",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "schwab",
    "trading",
    "api",
    "market-data",
    "stocks",
    "options"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "date-fns": "^4.4.0"
  },
  "packageManager": "yarn@4.18.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.69.0"
  }
}
